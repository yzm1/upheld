{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/yzm1/upheld/schemas/0.1/basis-output.schema.json",
  "title": "Upheld 0.1 basis-output",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "0.1"
        },
        "command": {
          "const": "basis"
        },
        "exit_code": {
          "const": 0
        },
        "defense_id": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "basis": {
          "type": "object",
          "properties": {
            "hashing_profile": {
              "type": "string",
              "minLength": 1
            },
            "promise": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "defense_assertion": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "artifacts": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              }
            },
            "subject_scope": {
              "type": "object",
              "properties": {
                "scope": {
                  "type": "string",
                  "minLength": 1
                },
                "hash": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                }
              },
              "required": [
                "scope",
                "hash"
              ],
              "additionalProperties": false
            },
            "environment": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              }
            }
          },
          "required": [
            "hashing_profile",
            "promise",
            "defense_assertion",
            "artifacts",
            "subject_scope",
            "environment"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schema_version",
        "command",
        "exit_code",
        "defense_id",
        "source",
        "basis"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "0.1"
        },
        "command": {
          "const": "basis"
        },
        "exit_code": {
          "enum": [
            1,
            2,
            5
          ]
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1
              },
              "subject": {
                "type": "string",
                "minLength": 1
              },
              "message": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "code",
              "subject",
              "message"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "schema_version",
        "command",
        "exit_code",
        "diagnostics"
      ],
      "additionalProperties": false
    }
  ]
}
