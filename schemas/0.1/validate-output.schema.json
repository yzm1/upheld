{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/yzm1/upheld/schemas/0.1/validate-output.schema.json",
  "title": "Upheld 0.1 validate-output",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "command": {
      "const": "validate"
    },
    "exit_code": {
      "enum": [
        0,
        1,
        2
      ]
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "subject": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "code",
          "subject",
          "message"
        ],
        "additionalProperties": false
      }
    },
    "migration_patch": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "schema_version",
    "command",
    "exit_code",
    "diagnostics"
  ],
  "additionalProperties": false
}
